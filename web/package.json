{
  "name": "git-review-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "dev": "node build.mjs && node --watch-path=src build.mjs",
    "lint": "eslint --cache --cache-location .cache/eslint .",
    "format": "prettier --cache --cache-location .cache/prettier --write .",
    "format:check": "prettier --cache --cache-location .cache/prettier --check .",
    "licenses": "node ../tools/generate-third-party-licenses.mjs",
    "licenses:check": "node ../tools/generate-third-party-licenses.mjs --check",
    "test": "node --test src/*.test.ts",
    "test:e2e": "puppeteer browsers install && node --test e2e/review.spec.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@preact/signals-core": "1.14.4",
    "codemirror": "6.0.2",
    "lit-html": "3.3.3"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "26.2.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "puppeteer": "25.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
