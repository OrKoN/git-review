load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_cross_binary")
load(":release.bzl", "release_binaries")

# gazelle:prefix git-review
# gazelle:resolve go git-review/web //web
# gazelle:exclude .tools
# gazelle:exclude bin
# gazelle:exclude web
gazelle(name = "gazelle")

filegroup(
    name = "build",
    srcs = [
        "//cmd/git-repo-server",
        "//cmd/git-review",
        "//cmd/git-review-hub",
    ],
    visibility = ["//visibility:public"],
)

release_binaries()

go_cross_binary(
    name = "git-review-hub-darwin_amd64",
    platform = "@rules_go//go/toolchain:darwin_amd64",
    target = "//cmd/git-review-hub",
)

filegroup(
    name = "release",
    srcs = [
        ":git-repo-server-linux_amd64",
        ":git-repo-server-linux_arm64",
        ":git-review-hub-darwin_amd64",
        ":git-review-hub-linux_amd64",
        ":git-review-hub-linux_arm64",
        ":git-review-linux_amd64",
        ":git-review-linux_arm64",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "frontend_checks",
    srcs = [
        ":third_party_licenses_check",
        "//web:lint",
        "//web:typecheck",
        "//web:unit_tests",
    ],
    visibility = ["//visibility:public"],
)

genrule(
    name = "third_party_licenses_check",
    srcs = [
        "//internal/licenses:THIRD_PARTY_LICENSES.txt",
        "//tools:generate-third-party-licenses.mjs",
        "MODULE.bazel",
        "go.mod",
        "//web:package-lock.json",
        "//web:package.json",
    ],
    outs = ["third-party-licenses.ok"],
    cmd = "node tools/generate-third-party-licenses.mjs --check && touch $@",
    tags = ["no-sandbox"],
)
